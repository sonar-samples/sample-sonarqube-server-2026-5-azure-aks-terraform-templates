edition: enterprise

jdbcOverwrite:
  enabled: true
  jdbcUrl: "jdbc:postgresql://${postgres_fqdn}:5432/sonarqube?sslmode=require"
  jdbcUsername: "sonarqube"
  jdbcSecretName: "sonarqube-db-credentials"
  jdbcSecretPasswordKey: "password"

monitoringPasscodeSecretName: "sonarqube-monitoring-passcode"
monitoringPasscodeSecretKey: "passcode"

nodeSelector:
  workload: system

%{ if settings_encryption ~}
sonarSecretKey: "sonarqube-encryption-secret"
%{ endif ~}
%{ if agentic ~}

# --- Agentic components ---------------------------------------------------------
#
# If the chart version you pinned does not yet ship agentic image defaults, set the
# repository and tag on each component below from the release notes.

agenticSigningSecret:
  existingSecret: "agentic-instance-secret"
  key: "instance-secret"

# On AKS use the platform's own sandbox. The chart's gVisor installer would fight
# the containerd configuration AKS manages itself.
gvisor:
  enabled: false
agentRuntimeSandbox:
  enabled: true
  runtimeClassName: ${runtime_class}

vortexAnalysis:
  enabled: true
  nodeSelector:
    workload: system
  storage:
    type: S3
    bucket: vortex-context
    region: us-east-1
    endpoint: "${minio_endpoint}"
    pathStyleAccess: true
    existingSecret: "vortex-storage-creds"

agentOrchestrator:
  enabled: true
  scheduler:
    enabled: true
  nodeSelector:
    workload: system
  storage:
    type: S3
    bucket: agent-jobs
    region: us-east-1
    endpoint: "${minio_endpoint}"
    pathStyle: true
    existingSecret: "agentic-storage-creds"

hunterAgent:
  enabled: true
  replicaCount: 1
  nodeSelector:
    workload: sandbox
  tolerations:
    - key: workload
      operator: Equal
      value: sandbox
      effect: NoSchedule
  networkPolicy:
    enabled: true

remediationAgent:
  enabled: true
  replicaCount: 1
  nodeSelector:
    workload: sandbox
  tolerations:
    - key: workload
      operator: Equal
      value: sandbox
      effect: NoSchedule
  networkPolicy:
    enabled: true

# No enabled flag — the egress proxy renders whenever a runtime does.
agentEgressProxy:
  allowedDomains:
%{ for d in llm_domains ~}
    - ${d}
%{ endfor ~}
    - minio.sonarqube.svc.cluster.local
  networkPolicy:
    enabled: true
    egressPorts: [80, 443]
    egressExcludeCidrs:
      - 169.254.0.0/16

# SonarQube Server writes the analyzer context Vortex restores, so both must point
# at the same bucket.
sonarProperties:
  sonar.agentic.storage.type: S3
  sonar.agentic.storage.bucket: vortex-context
  sonar.agentic.storage.region: us-east-1
  sonar.agentic.storage.endpoint: "${minio_endpoint}"
  sonar.agentic.storage.path-style-access: "true"
%{ endif ~}
