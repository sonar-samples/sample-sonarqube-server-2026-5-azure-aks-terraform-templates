edition: enterprise
%{ if server_image_tag != "" ~}
# The chart composes the tag from Chart.AppVersion when `edition` is set and this is
# empty, so a chart whose appVersion lags its version would deploy the older Server.
image:
  tag: "${server_image_tag}"
%{ endif ~}

jdbcOverwrite:
  enabled: true
  jdbcUrl: "jdbc:postgresql://${postgres_fqdn}:5432/sonarqube?sslmode=require"
  jdbcUsername: "sonarqube"
  jdbcSecretName: "sonarqube-db-credentials"
  jdbcSecretPasswordKey: "password"

monitoringPasscodeSecretName: "sonarqube-monitoring-passcode"
monitoringPasscodeSecretKey: "passcode"

nodeSelector:
  workload: system
%{ if settings_encryption ~}

sonarSecretKey: "sonarqube-encryption-secret"
%{ endif ~}
%{ if agentic ~}

# --- Agentic components -------------------------------------------------------------

agenticSigningSecret:
  existingSecret: "agentic-instance-secret"
  key: "instance-secret"

# On AKS use the platform's own pod sandboxing. The chart's gVisor installer is a
# privileged DaemonSet that rewrites containerd configuration, which AKS manages itself.
gvisor:
  enabled: false
agentRuntimeSandbox:
  enabled: true
  runtimeClassName: ${runtime_class}

# SonarQube Server writes the analyzer context Vortex restores, so it mounts the same
# share and both point at the same path.
sonarProperties:
  sonar.agentic.storage.type: FILESYSTEM
  sonar.agentic.storage.filesystem.base-dir: ${vortex_base_dir}

extraVolumes:
  - name: vortex-context
    persistentVolumeClaim:
      claimName: ${vortex_claim}
extraVolumeMounts:
  - name: vortex-context
    mountPath: ${vortex_base_dir}

vortexAnalysis:
  enabled: true
  # The chart ships blank image defaults; validation fails without these.
  image:
    repository: "${images.vortex.repository}"
    tag: "${images.vortex.tag}"
  nodeSelector:
    workload: system
  # bucket/region are meaningless for a file backend; the chart gates them on type.
  storage:
    type: FILESYSTEM
    filesystem:
      baseDir: ${vortex_base_dir}
  extraVolumes:
    - name: vortex-context
      persistentVolumeClaim:
        claimName: ${vortex_claim}
  # Vortex only reads context. SonarQube Server writes it.
  extraVolumeMounts:
    - name: vortex-context
      mountPath: ${vortex_base_dir}
      readOnly: true

agentOrchestrator:
  enabled: true
  # The chart ships blank image defaults; validation fails without these.
  image:
    repository: "${images.orchestrator.repository}"
    tag: "${images.orchestrator.tag}"
  scheduler:
    enabled: true
  nodeSelector:
    workload: system
  storage:
    type: FILESYSTEM
    filesystem:
      baseDir: ${jobs_base_dir}
  # Mounts the share at its root and writes each runtime's jobs into a subdirectory
  # named after that runtime.
  extraVolumes:
    - name: agentic-jobs
      persistentVolumeClaim:
        claimName: ${jobs_claim}
  extraVolumeMounts:
    - name: agentic-jobs
      mountPath: ${jobs_base_dir}

hunterAgent:
  enabled: true
  # The chart ships blank image defaults; validation fails without these.
  image:
    repository: "${images.hunter.repository}"
    tag: "${images.hunter.tag}"
  replicaCount: 1
  nodeSelector:
    workload: sandbox
  tolerations:
    - key: workload
      operator: Equal
      value: sandbox
      effect: NoSchedule
  networkPolicy:
    enabled: true
  # Mounts ONLY its own subdirectory, so it cannot see the other runtime's files.
  # Chart validation requires a mountPath at or above storage.filesystem.baseDir.
  storage:
    type: FILESYSTEM
    filesystem:
      baseDir: ${jobs_base_dir}/hunter
  extraVolumes:
    - name: agentic-jobs
      persistentVolumeClaim:
        claimName: ${jobs_claim}
  extraVolumeMounts:
    - name: agentic-jobs
      mountPath: ${jobs_base_dir}/hunter
      subPath: hunter

remediationAgent:
  enabled: true
  # The chart ships blank image defaults; validation fails without these.
  image:
    repository: "${images.remediation.repository}"
    tag: "${images.remediation.tag}"
  replicaCount: 1
  nodeSelector:
    workload: sandbox
  tolerations:
    - key: workload
      operator: Equal
      value: sandbox
      effect: NoSchedule
  networkPolicy:
    enabled: true
  storage:
    type: FILESYSTEM
    filesystem:
      baseDir: ${jobs_base_dir}/remediation
  extraVolumes:
    - name: agentic-jobs
      persistentVolumeClaim:
        claimName: ${jobs_claim}
  extraVolumeMounts:
    - name: agentic-jobs
      mountPath: ${jobs_base_dir}/remediation
      subPath: remediation

# No enabled flag — the egress proxy renders whenever a runtime does. With a filesystem
# backend only the LLM provider needs allowing; storage is a mount, not a network call.
agentEgressProxy:
  allowedDomains:
%{ for d in llm_domains ~}
    - ${d}
%{ endfor ~}
  networkPolicy:
    enabled: true
    egressPorts: [80, 443]
    egressExcludeCidrs:
      - 169.254.0.0/16
%{ endif ~}
