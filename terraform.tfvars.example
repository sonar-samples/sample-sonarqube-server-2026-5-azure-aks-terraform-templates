subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "westeurope"

resource_group_name = "sonarqube-2026-5"
cluster_name        = "sonarqube-aks"
postgres_name       = "sonarqube-pg-changeme" # globally unique

# REQUIRED. See README "Release status" before setting this.
sonarqube_chart_version = "2026.5.x"

# The release-approved Server image tag. Chart version and image version are a tested tuple —
# do not leave this empty and rely on the chart composing a tag from appVersion.
sonarqube_image_tag = "<approved Server tag>"

# Required when enable_agentic = true. The chart ships blank defaults, so validation fails
# without these. Take them from the release's approved image manifest.
agentic_images = {
  vortex       = { repository = "<repo>", tag = "<tag>" }
  orchestrator = { repository = "<repo>", tag = "<tag>" }
  hunter       = { repository = "<repo>", tag = "<tag>" }
  remediation  = { repository = "<repo>", tag = "<tag>" }
}

# Required when enable_agentic = true. Discover it, do not guess:
#   kubectl get runtimeclass
sandbox_runtime_class = ""

# Leave false until the pinned chart version ships the agentic components.
enable_agentic = false

# Set true only on a second apply, after creating sonarqube-encryption-secret.
enable_settings_encryption = false

llm_allowed_domains = ["api.anthropic.com"]

# Azure Files share sizes. Job artifacts are roughly
# (jobs/day x retention days x 1MB) plus headroom for in-flight repo archives;
# Vortex analyzer context is considerably larger per project.
jobs_storage_size   = "100Gi"
vortex_storage_size = "100Gi"

tags = {
  # Team = "..."   # add whatever your subscription policy requires
}
